@page "/recetas/{Id:int}"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IRecetaService recetaService
@inject IComentarioService comentarioService
@inject ICategoriaService categoriaService
@inject IIngredienteService ingredienteService
@inject NavigationManager navigation
@inject IJSRuntime JSRuntime

<PageTitle>@(receta?.Titulo ?? "Receta")</PageTitle>

<div class="container-fluid py-4">
    @if (receta == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-brand" role="status"></div>
            <p class="text-muted mt-3">Cargando receta...</p>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-12">
                <button class="btn btn-outline-secondary btn-sm mb-3" @onclick="VolverARecetas">
                    <span class="bi bi-arrow-left me-1"></span> Volver a Recetas
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success alert-dismissible fade show">
                @mensajeExito
                <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
            </div>
        }
        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger alert-dismissible fade show">
                @mensajeError
                <button type="button" class="btn-close" @onclick="() => mensajeError = string.Empty"></button>
            </div>
        }

        <div class="row">
            <!-- Columna principal -->
            <div class="col-12 col-lg-8">
                <!-- Encabezado -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h1 class="h3 text-brand mb-1">@receta.Titulo</h1>
                                @if (receta.EstaPublicado)
                                {
                                    <span class="badge bg-success">Publicado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Borrador</span>
                                }
                            </div>
                            <AuthorizeView>
                                <Authorized>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="dropdown">
                                            <span class="bi bi-three-dots-vertical"></span>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <button class="dropdown-item" @onclick="IrAEditar">
                                                    <span class="bi bi-pencil me-2"></span>Editar
                                                </button>
                                            </li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <button class="dropdown-item text-danger" @onclick="EliminarReceta">
                                                    <span class="bi bi-trash me-2"></span>Eliminar
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        </div>

                        @if (!string.IsNullOrEmpty(receta.Descripcion))
                        {
                            <p class="text-muted">@receta.Descripcion</p>
                        }

                        <div class="d-flex gap-4 text-muted small">
                            <span><span class="bi bi-clock me-1"></span>Prep: @receta.TiempoPreparacionMinutos min</span>
                            <span><span class="bi bi-fire me-1"></span>Cocción: @receta.TiempoCoccionMinutos min</span>
                            <span><span class="bi bi-people me-1"></span>@receta.Porciones porciones</span>
                            <span><span class="bi bi-hourglass-split me-1"></span>Total: @(receta.TiempoPreparacionMinutos + receta.TiempoCoccionMinutos) min</span>
                        </div>
                    </div>
                </div>

                <!-- Instrucciones -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><span class="bi bi-list-ol me-2"></span>Instrucciones</h5>
                    </div>
                    <div class="card-body">
                        <div style="white-space: pre-line;">@receta.Instrucciones</div>
                    </div>
                </div>

                <!-- Comentarios -->
                <div class="card border-0 shadow-sm mb-4 overflow-hidden">
                    <div class="card-header bg-white border-0 py-3 px-4">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex align-items-center justify-content-center rounded-circle bg-light"
                                     style="width: 42px; height: 42px;">
                                    <span class="bi bi-chat-square-text fs-5 text-brand"></span>
                                </div>
                                <div>
                                    <h5 class="mb-0 fw-bold">Comentarios</h5>
                                    <small class="text-muted">Comparte tu opinión sobre esta receta</small>
                                </div>
                            </div>

                            <span class="badge rounded-pill bg-brand px-3 py-2">
                                @(comentarios?.Count ?? 0) comentario(s)
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-4">

                        <AuthorizeView>
                            <Authorized>
                                <div class="comment-composer mb-4 p-3 rounded-4 border bg-light-subtle">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="rounded-circle bg-brand text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                             style="width: 42px; height: 42px; font-size: 0.95rem; font-weight: 700;">
                                            @(string.IsNullOrWhiteSpace(usuarioActualId) ? "U" : usuarioActualId[0].ToString().ToUpper())
                                        </div>

                                        <div class="flex-grow-1">
                                            <textarea class="form-control border-0 bg-white rounded-4 px-3 py-3 mb-2"
                                                      rows="3"
                                                      placeholder="Escribe tu comentario aquí..."
                                                      maxlength="500"
                                                      @bind="nuevoComentario"
                                                      @bind:event="oninput"
                                                      @onkeydown="HandleKeyDown"
                                                      style="resize: none; box-shadow: none;"></textarea>

                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                                <span class="text-muted small">@(nuevoComentario?.Length ?? 0) / 500</span>

                                                <button class="btn btn-brand btn-sm rounded-pill px-4"
                                                        @onclick="CrearComentario"
                                                        disabled="@(string.IsNullOrWhiteSpace(nuevoComentario) || enviandoComentario)">
                                                    @if (enviandoComentario)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                                        <span>Publicando...</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="bi bi-send-fill me-2"></span>
                                                        <span>Publicar comentario</span>
                                                    }
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </Authorized>

                            <NotAuthorized>
                                <div class="text-center py-4 px-3 mb-4 rounded-4 border bg-light">
                                    <div class="mb-2">
                                        <span class="bi bi-lock fs-3 text-muted"></span>
                                    </div>
                                    <p class="mb-1 fw-semibold">Inicia sesión para participar</p>
                                    <p class="text-muted small mb-2">Solo los usuarios autenticados pueden comentar esta receta.</p>
                                    <a href="/login" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                        Ir al login
                                    </a>
                                </div>
                            </NotAuthorized>
                        </AuthorizeView>

                        @if (comentarios == null)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border spinner-border-sm text-brand mb-2" role="status"></div>
                                <p class="text-muted small mb-0">Cargando comentarios...</p>
                            </div>
                        }
                        else if (!comentarios.Any())
                        {
                            <div class="text-center py-5">
                                <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mb-3"
                                     style="width: 70px; height: 70px;">
                                    <span class="bi bi-chat-left-text fs-2 text-muted"></span>
                                </div>
                                <p class="fw-semibold mb-1">Todavía no hay comentarios</p>
                                <p class="text-muted small mb-0">Sé el primero en compartir tu experiencia con esta receta.</p>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var comentario in comentarios.OrderByDescending(c => c.CreadoUtc))
                                {
                                    var esMio = EsComentarioDelUsuarioActual(comentario);

                                    <div class="border rounded-4 p-3 p-md-4 bg-white shadow-sm">
                                        <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                                            <div class="d-flex align-items-start gap-3">
                                                <div class="rounded-circle bg-brand text-white d-flex align-items-center justify-content-center flex-shrink-0"
                                                     style="width: 46px; height: 46px; font-size: 1rem; font-weight: 700;">
                                                    @comentario.UsuarioId[0].ToString().ToUpper()
                                                </div>

                                                <div>
                                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        <span class="fw-bold text-dark">
                                                            Usuario @(comentario.UsuarioId.Length >= 6 ? comentario.UsuarioId[..6] : comentario.UsuarioId)
                                                        </span>

                                                        @if (esMio)
                                                        {
                                                            <span class="badge rounded-pill text-bg-light border">Tu comentario</span>
                                                        }
                                                    </div>

                                                    <div class="text-muted small mt-1">
                                                        <span class="bi bi-clock me-1"></span>
                                                        @comentario.CreadoUtc.ToString("dd/MM/yyyy HH:mm")
                                                    </div>
                                                </div>
                                            </div>

                                            @if (esMio && comentarioEditandoId != comentario.Id)
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3"
                                                            title="Editar"
                                                            @onclick="() => IniciarEdicion(comentario)">
                                                        <span class="bi bi-pencil-square me-1"></span>
                                                        Editar
                                                    </button>

                                                    <button class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                            title="Eliminar"
                                                            @onclick="() => EliminarComentario(comentario.Id)">
                                                        <span class="bi bi-trash3 me-1"></span>
                                                        Eliminar
                                                    </button>
                                                </div>
                                            }
                                        </div>

                                        @if (comentarioEditandoId == comentario.Id)
                                        {
                                            <div class="mt-3">
                                                <textarea class="form-control rounded-4 mb-3"
                                                          rows="3"
                                                          maxlength="500"
                                                          @bind="textoEdicion"
                                                          @bind:event="oninput"
                                                          style="resize: none;"></textarea>

                                                <div class="d-flex justify-content-end gap-2 flex-wrap">
                                                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3"
                                                            @onclick="CancelarEdicion">
                                                        Cancelar
                                                    </button>

                                                    <button class="btn btn-brand btn-sm rounded-pill px-3"
                                                            @onclick="() => GuardarEdicion(comentario.Id)">
                                                        <span class="bi bi-check2-circle me-1"></span>
                                                        Guardar cambios
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mt-3 pt-3 border-top">
                                                <p class="mb-0 text-dark" style="white-space: pre-line; line-height: 1.7;">
                                                    @comentario.Contenido
                                                </p>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-12 col-lg-4">
                <!-- Categorías -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><span class="bi bi-tags me-2"></span>Categorías</h5>
                    </div>
                    <div class="card-body">
                        @if (receta.CategoriaIds.Any() && categorias != null)
                        {
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var catId in receta.CategoriaIds)
                                {
                                    var cat = categorias.FirstOrDefault(c => c.Id == catId);
                                    if (cat != null)
                                    {
                                        <span class="badge bg-brand">@cat.Nombre</span>
                                    }
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Sin categorías</p>
                        }
                    </div>
                </div>

                <!-- Ingredientes -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><span class="bi bi-basket me-2"></span>Ingredientes</h5>
                    </div>
                    <div class="card-body">
                        @if (receta.IngredienteIds.Any() && ingredientes != null)
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var ingId in receta.IngredienteIds)
                                {
                                    var ing = ingredientes.FirstOrDefault(i => i.Id == ingId);
                                    if (ing != null)
                                    {
                                        <li class="list-group-item px-0">
                                            <span class="bi bi-check2 text-brand me-2"></span>@ing.Nombre
                                        </li>
                                    }
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Sin ingredientes</p>
                        }
                    </div>
                </div>

                <!-- Info -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white">
                        <h5 class="mb-0"><span class="bi bi-info-circle me-2"></span>Información</h5>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2">
                                <span class="text-muted small">Creado:</span><br />
                                @receta.CreadoUtc.ToString("dd/MM/yyyy HH:mm")
                            </li>
                            <li class="mb-2">
                                <span class="text-muted small">Modificado:</span><br />
                                @receta.ModificadoUtc.ToString("dd/MM/yyyy HH:mm")
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private RecetaDto? receta;
    private List<ComentarioDto>? comentarios;
    private List<CategoriaDto>? categorias;
    private List<IngredienteDto>? ingredientes;
    private string nuevoComentario = "";
    private bool enviandoComentario = false;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    private int? comentarioEditandoId = null;
    private string textoEdicion = "";
    private bool guardandoEdicion = false;
    private string? usuarioActualId;

    private void VolverARecetas() => navigation.NavigateTo("/recetas");
    private void IrAEditar() => navigation.NavigateTo($"/recetas/editar/{Id}");

    /*protected override async Task OnInitializedAsync()
    {
        var tareaReceta = recetaService.ObtenerPorId(Id);
        var tareaComentarios = comentarioService.ObtenerPorReceta(Id);
        var tareaCategorias = categoriaService.ObtenerTodas();
        var tareaIngredientes = ingredienteService.ObtenerTodos();

        await Task.WhenAll(tareaReceta, tareaComentarios, tareaCategorias, tareaIngredientes);

        receta = tareaReceta.Result;
        comentarios = tareaComentarios.Result;
        categorias = tareaCategorias.Result;
        ingredientes = tareaIngredientes.Result;

        if (receta == null)
        {
            navigation.NavigateTo("/recetas");
        }
    }*/

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        usuarioActualId =
            authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
            ?? authState.User.FindFirst("sub")?.Value;

        var tareaReceta = recetaService.ObtenerPorId(Id);
        var tareaComentarios = comentarioService.ObtenerPorReceta(Id);
        var tareaCategorias = categoriaService.ObtenerTodas();
        var tareaIngredientes = ingredienteService.ObtenerTodos();

        await Task.WhenAll(tareaReceta, tareaComentarios, tareaCategorias, tareaIngredientes);

        receta = tareaReceta.Result;
        comentarios = tareaComentarios.Result;
        categorias = tareaCategorias.Result;
        ingredientes = tareaIngredientes.Result;

        if (receta == null)
        {
            navigation.NavigateTo("/recetas");
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !string.IsNullOrWhiteSpace(nuevoComentario))
        {
            await CrearComentario();
        }
    }

    private async Task CrearComentario()
    {
        if (string.IsNullOrWhiteSpace(nuevoComentario)) return;

        enviandoComentario = true;

        var dto = new ComentarioCreacionDto
        {
            Contenido = nuevoComentario.Trim(),
            RecetaId = Id
        };

        var resultado = await comentarioService.Crear(dto);

        if (resultado != null)
        {
            nuevoComentario = "";
            mensajeExito = "¡Comentario publicado!";
            comentarios = await comentarioService.ObtenerPorReceta(Id);
            await Task.Delay(2000);
            mensajeExito = string.Empty;
        }
        else
        {
            mensajeError = "No se pudo agregar el comentario.";
        }

        enviandoComentario = false;
    }

    private async Task EliminarComentario(int comentarioId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "¿Eliminar este comentario?"))
            return;

        var resultado = await comentarioService.Eliminar(comentarioId);

        if (resultado)
        {
            comentarios = await comentarioService.ObtenerPorReceta(Id);
        }
        else
        {
            mensajeError = "No se pudo eliminar el comentario.";
        }
    }

    private async Task EliminarReceta()
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "¿Estás seguro de eliminar esta receta? Esta acción no se puede deshacer."))
            return;

        var resultado = await recetaService.Eliminar(Id);

        if (resultado)
        {
            navigation.NavigateTo("/recetas");
        }
        else
        {
            mensajeError = "No se pudo eliminar la receta.";
        }
    }

    private void IniciarEdicion(ComentarioDto comentario)
    {
        comentarioEditandoId = comentario.Id;
        textoEdicion = comentario.Contenido;
        mensajeError = string.Empty;
        mensajeExito = string.Empty;
    }

    private void CancelarEdicion()
    {
        comentarioEditandoId = null;
        textoEdicion = "";
    }

    private async Task GuardarEdicion(int comentarioId)
    {
        if (string.IsNullOrWhiteSpace(textoEdicion))
            return;

        guardandoEdicion = true;
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        var dto = new ComentarioModificacionDto
        {
            Contenido = textoEdicion.Trim(),
            
        };

        var resultado = await comentarioService.Actualizar(comentarioId, dto);

        if (resultado)
        {
            comentarios = await comentarioService.ObtenerPorReceta(Id);
            comentarioEditandoId = null;
            textoEdicion = "";
            mensajeExito = "Comentario actualizado correctamente.";
            await Task.Delay(2000);
            mensajeExito = string.Empty;
        }
        else
        {
            mensajeError = "No se pudo actualizar el comentario.";
        }

        guardandoEdicion = false;
    }

    private bool EsComentarioDelUsuarioActual(ComentarioDto comentario)
    {
        if (string.IsNullOrWhiteSpace(usuarioActualId) || string.IsNullOrWhiteSpace(comentario.UsuarioId))
            return false;

        return usuarioActualId == comentario.UsuarioId;
    }
}